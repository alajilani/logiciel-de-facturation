# Invoice Web Application - Configuration d'environ Variables

# Django Settings
SECRET_KEY=django-insecure-your-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://your-domain.com

# Production Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 (optionnel)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Sentry (optionnel)
SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# ASSISTANT IA - CONFIGURATION OPENAI
# =============================================================================

# Fournisseur d'IA à utiliser
# Options: openai, ollama, local, togetherai
# Par défaut: local (réponses pré-programmées rapides)
AI_PROVIDER=openai

# Clé API pour authentification auprès du fournisseur
# Pour OpenAI: Aller sur https://platform.openai.com/api-keys
# Format: sk-...
# ⚠️ IMPORTANT: Garder cette clé secrète!
AI_API_KEY=sk-YOUR-API-KEY-HERE

# Modèle d'IA à utiliser
# RECOMMANDÉ: gpt-4o-mini (rapide, bon qualité, bon marché)
# Autres: gpt-4o, gpt-3.5-turbo
AI_MODEL=gpt-4o-mini

# Température de génération (0.0=déterministe, 1.0=créatif)
# Pour assistant de facturation: 0.4 est idéal
AI_TEMPERATURE=0.4

# Nombre maximum de tokens par réponse
# 300 tokens ≈ 1200 caractères
AI_MAX_TOKENS=300

# Activer/Désactiver le chat IA
AI_CHAT_ENABLED=True

# URL personnalisée de l'API (optionnel)
# Par défaut: https://api.openai.com/v1/chat/completions
# Pour Ollama: http://localhost:11434/v1/chat/completions
# AI_API_BASE=https://api.openai.com/v1/chat/completions

